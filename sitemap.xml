---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- ── Homepage ── -->
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- ── Static pages ── -->
  {% assign excluded = '404,brand-guide,thank-you,sitemap,proposals' | split: ',' %}
  {% for page in site.pages %}
    {% assign skip = false %}
    {% for ex in excluded %}
      {% if page.url contains ex %}{% assign skip = true %}{% endif %}
    {% endfor %}
    {% if skip == false and page.url != '/' %}
    <url>
      <loc>{{ site.url }}{{ page.url }}</loc>
      {% if page.url contains '/services' or page.url contains '/blog' %}
      <changefreq>weekly</changefreq>
      <priority>0.9</priority>
      {% elsif page.url contains '/terms' or page.url contains '/privacy' %}
      <changefreq>yearly</changefreq>
      <priority>0.3</priority>
      {% else %}
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
      {% endif %}
    </url>
    {% endif %}
  {% endfor %}

  <!-- ── Blog posts ── -->
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

</urlset>
